{
  "name": "Faerûn Cartographers Plat Standard",
  "version": "1.8",
  "aspect_ratio": [
    19,
    13
  ],
  "sheet_inches": {
    "width": 19,
    "height": 13
  },
  "left_panel_width_pct": 20,
  "map_field_width_pct": 80,
  "left_zones": [
    {
      "id": "title",
      "from_pct": 0,
      "to_pct": 15
    },
    {
      "id": "map_information",
      "from_pct": 15,
      "to_pct": 30
    },
    {
      "id": "variable_legend",
      "from_pct": 30,
      "to_pct": 90
    },
    {
      "id": "compass_seal_scale",
      "from_pct": 90,
      "to_pct": 100
    }
  ],
  "font_family": "Arial, sans-serif",
  "font_pt": {
    "location_name": 36,
    "map_type": 18,
    "byline": 11,
    "section_header": 13,
    "info_label": 9,
    "info_value": 9,
    "legend": 9,
    "important_location": 8.5,
    "feature": 10,
    "grid": 8,
    "scale": 8
  },
  "grid": {
    "cols": 17,
    "row_count": 16,
    "col_labels": "ABCDEFGHIJKLMNOPQ",
    "row_labels": "1..16",
    "square_cells": true,
    "labels_all_four_edges": true
  },
  "symbols": {
    "compass": {
      "fixed_diameter_pt": 72,
      "fixed_across_all_plats": true
    },
    "seal": {
      "image": "assets/faerun-cartographers-official-red-seal.png",
      "aspect_ratio": 1,
      "circular": true,
      "rotation_allowed": true,
      "may_overlap_upper_section": true,
      "no_stretching": true
    },
    "scale": {
      "below_compass_and_seal": true,
      "must_match_grid_scale": true
    }
  },
  "source_geography": {
    "land_water_master_required_for_derivatives": true,
    "do_not_reinterpret_shorelines": true
  },
  "contour_elevation_claim": "Only label measured elevation/depth if backed by source; otherwise mark interpretive."
}
